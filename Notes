CREATE DATABASE rural_urban;
USE rural_urban;

CREATE TABLE accounts (
    id INT AUTO_INCREMENT PRIMARY KEY,
    role VARCHAR(30) UNIQUE,
    user VARCHAR(50) UNIQUE NOT NULL,
    pass VARCHAR(255),
    #email VARCHAR(255) UNIQUE
    admin BOOLEAN UNIQUE # Only one can be admin because we only check one unqiue 'true'
);


ALTER TABLE accounts
ADD previouspass varchar(255);
$ For admin bool, Use true/null

ALTER TABLE accounts
ADD name varchar(30) UNIQUE

CREATE TABLE inventory (
    prod_id varchar(15) PRIMARY KEY, // FROM UNIQUE NOT NULL
    product varchar(30),
    quantity INT UNSIGNED,
    metric varhar(10),
    status varchar(50),
    description TINYTEXT,
    order_date DATE NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
    update_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);
ALTER TABLE inventory
MODIFY COLUMN prod_id varchar(15) PRIMARY KEY;

stock_in DECMIAL(10,2),
stock_out DECIMAL(10,2),
To rename a column: ALTER TABLE inventory CHANGE update_at updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP;

ALTER TABLE inventory
ADD stock_in DECIMAL(10,2),
ADD stock_out DECIMAL(10,2);

CREATE TABLE production (
production_id INT PRIMARY KEY AUTO_INCREMENT,
batch_id VARCHAR(7),// FROM TINYINT UNSIGNED
production_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
quantity DECIMAL(10,2),
unit varchar(5),
item varchar(15)
);
ALTER TABLE production
MODIFY COLUMN batch_id varchar(7);

